		(uuid "d881ab22-055b-4c0b-b2d1-f36e58a16bbd")
	)
	(text "External override header for power supply. \nNote that 5V has a schottky, 3v3 does not.\nTo override 3v3 the 3v3 override jumper JP1 must be cut"
		(exclude_from_sim no)
		(at 216.662 34.036 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d8f929cc-1c62-434b-a532-cc238f8605d2")
	)
	(text "Feedback resistors are biased for 5.3V, \nshould give circa 5V after the Schottky. \nVBus is protected against reverse bias \nso USB should never see this voltage if \nboth are plugged in."
		(exclude_from_sim no)
		(at 154.686 67.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e2a5866e-1ba4-48a8-9031-e31e936e223a")
	)
